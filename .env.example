# 진단 에이전트용 LLM 제공사 (core/llm.py에서 분기)
LLM_PROVIDER=azure_openai

# 진단 에이전트용 Azure OpenAI (진단 대상 llm-gateway와 별도 배포)
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
# Responses API(gpt-6.1-sol 도구 호출)는 2025-03-01-preview 이상이 필요하다
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# 모델(배포) 이름은 여기 두지 않는다. 에이전트 버전의 config.py가 역할별로 정한다

# 사내 SSL 프록시 CA 번들 경로 (필요 시)
REQUESTS_CA_BUNDLE=
SSL_CERT_FILE=

# 실행 추적 (Phoenix, OpenTelemetry)
OTEL_EXPORTER_OTLP_ENDPOINT=
# Phoenix 프로젝트 이름 (실서비스 전까지 test)
# PHOENIX_PROJECT_NAME=test

# Slack 봇 토큰 (개인 워크스페이스 앱, chat:write). 비우면 알림은 보내지 않고 알림 이력에만 남는다(dry-run)
# make kg-up이 kubeguardian-env Secret에 넣는다. 채팅에 붙여 넣지 않는다
SLACK_BOT_TOKEN=
