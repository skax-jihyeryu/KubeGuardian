# 진단 에이전트용 LLM 제공사 (core/llm.py에서 분기)
LLM_PROVIDER=azure_openai

# 진단 에이전트용 Azure OpenAI (진단 대상 llm-gateway와 별도 배포)
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
# Responses API(gpt-6.1-sol 도구 호출)는 2025-03-01-preview 이상이 필요하다
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# 모델(배포) 이름은 여기 두지 않는다. 에이전트 버전의 config.py가 역할별로 정한다

# 사내 SSL 프록시 CA 번들 경로 (필요 시)
REQUESTS_CA_BUNDLE=
SSL_CERT_FILE=

# 진단 대상
KG_TARGET_NAMESPACE=dev

# 실행 추적 (Phoenix, OpenTelemetry)
OTEL_EXPORTER_OTLP_ENDPOINT=
