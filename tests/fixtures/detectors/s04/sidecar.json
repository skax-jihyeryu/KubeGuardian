{
  "_description": "S04: gateway가 같은 Pod 사이드카(cache:6379)를 localhost로 호출 (정상)",
  "merge": {
    "Deployment": [
      {
        "metadata": {
          "name": "gateway"
        },
        "spec": {
          "template": {
            "spec": {
              "containers": [
                {
                  "name": "gateway",
                  "image": "gateway:1.0",
                  "ports": [
                    {
                      "name": "http",
                      "containerPort": 8000
                    }
                  ],
                  "readinessProbe": {
                    "httpGet": {
                      "path": "/health",
                      "port": 8000
                    }
                  },
                  "resources": {
                    "requests": {
                      "cpu": "100m",
                      "memory": "128Mi"
                    },
                    "limits": {
                      "cpu": "500m",
                      "memory": "256Mi"
                    }
                  },
                  "env": [
                    {
                      "name": "CACHE_URL",
                      "value": "http://localhost:6379"
                    }
                  ]
                },
                {
                  "name": "cache",
                  "image": "redis:7",
                  "ports": [
                    {
                      "containerPort": 6379
                    }
                  ]
                }
              ]
            }
          }
        }
      }
    ]
  }
}