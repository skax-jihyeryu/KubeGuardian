{
  "_description": "gateway env가 Service에 없는 포트와 없는 Service를 가리킴",
  "merge": {
    "Deployment": [
      {
        "metadata": {
          "name": "gateway"
        },
        "spec": {
          "template": {
            "spec": {
              "containers": [
                {
                  "name": "gateway",
                  "image": "gateway:1.0",
                  "ports": [
                    {
                      "name": "http",
                      "containerPort": 8000
                    }
                  ],
                  "readinessProbe": {
                    "httpGet": {
                      "path": "/health",
                      "port": 8000
                    }
                  },
                  "resources": {
                    "requests": {
                      "cpu": "100m",
                      "memory": "128Mi"
                    },
                    "limits": {
                      "cpu": "500m",
                      "memory": "256Mi"
                    }
                  },
                  "env": [
                    {
                      "name": "AGENT_SERVICE_URL",
                      "value": "http://agent:9999"
                    },
                    {
                      "name": "ADMIN_SERVICE_URL",
                      "value": "http://admin:8001"
                    }
                  ]
                }
              ]
            }
          }
        }
      }
    ]
  }
}
