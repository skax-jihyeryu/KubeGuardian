{
  "_description": "gateway 컨테이너에 limits가 없고 requests.cpu만 있음",
  "merge": {
    "Pod": [
      {
        "metadata": {
          "name": "gateway-6d4b9c7f8-abcde"
        },
        "spec": {
          "containers": [
            {
              "name": "gateway",
              "image": "gateway:1.0",
              "ports": [
                {
                  "name": "http",
                  "containerPort": 8000
                }
              ],
              "readinessProbe": {
                "httpGet": {
                  "path": "/health",
                  "port": 8000
                }
              },
              "resources": {
                "requests": {
                  "cpu": "100m"
                }
              }
            }
          ]
        }
      }
    ]
  }
}
